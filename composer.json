{
    "name": "jeffersongoncalves/laravel-us-privacy",
    "description": "US state privacy laws for Laravel: the rules of 18 state laws (Virginia, Colorado, Texas...), their applicability, and a personal data inventory",
    "keywords": [
        "laravel",
        "privacy",
        "us-privacy",
        "vcdpa",
        "cpa",
        "ctdpa",
        "tdpsa",
        "state-privacy-laws"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-us-privacy",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\UsPrivacy\\UsPrivacyServiceProvider"
            ],
            "aliases": {
                "UsPrivacy": "JeffersonGoncalves\\UsPrivacy\\Facades\\UsPrivacy"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
